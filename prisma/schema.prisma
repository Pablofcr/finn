generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  DIGITAL_WALLET
  INVESTMENT
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum OccurrenceStatus {
  PENDING
  PAID
  SNOOZED
  SKIPPED
}

enum BotPlatform {
  WHATSAPP
  TELEGRAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  PROCESSING
  PARSED
  CONFIRMED
  REJECTED
  ERROR
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum Currency {
  BRL
  USD
  EUR
  GBP
}

enum PaymentMethod {
  PIX
  DEBIT
  CREDIT
  CASH
  BOLETO
  TRANSFER
  /// Cartão refeição (VR) — Sodexo Refeição, Alelo Refeição, Ticket
  /// Refeição, Pluxee Refeição. Usado em restaurantes, lanchonetes, padarias.
  MEAL_VOUCHER
  /// Cartão alimentação (VA) — Sodexo Alimentação, Alelo Alimentação,
  /// Ticket Alimentação, Pluxee Alimentação. Usado em supermercados.
  FOOD_VOUCHER
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

enum UserPlan {
  FREE
  PRO
  MASTER
}

/// Estado da assinatura. Trial: primeiros 14 dias do Diagnóstico (acesso
/// completo, sem cartão). Active: pagante. Cancelled: cancelou mas ainda
/// tem acesso até currentPeriodEnd. Expired: trial venceu sem conversão
/// OU assinatura expirou — bloqueio do app, paywall obrigatório.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

/// Plano da assinatura. TRIAL durante os 14 dias do Diagnóstico.
/// MONTHLY = R$ 19,90/mês. ANNUAL = R$ 178,80/ano (~R$ 14,90/mês,
/// pagável PIX à vista ou cartão 12x sem juros).
enum SubscriptionPlan {
  TRIAL
  MONTHLY
  ANNUAL
}

// ============================================================
// MODELS
// ============================================================

model User {
  id              String   @id @default(uuid())
  supabaseId      String   @unique
  email           String   @unique
  name            String
  phone           String?
  avatarUrl       String?
  plan            UserPlan @default(FREE)
  defaultCurrency Currency @default(BRL)
  timezone        String   @default("America/Sao_Paulo")
  locale          String   @default("pt-BR")
  /// Quantas vezes o user dispensou o banner "Conecte o WhatsApp" no
  /// dashboard. Ao bater 2, paramos — /bot continua acessível via menu.
  whatsappNudgeDismissedCount Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  goals                 Goal[]
  botConnections        BotConnection[]
  botMessages           BotMessage[]
  insights              Insight[]
  recurringTransactions RecurringTransaction[]
  notificationSetting   NotificationSetting?
  invoices              Invoice[]
  reengagementNudges    ReengagementNudge[]
  subscription          Subscription?

  @@index([supabaseId])
  @@index([email])
}

/// Estado da assinatura do usuário. 1 user = 1 subscription (ativa ou
/// histórica). Criada na primeira autenticação como TRIAL com janela de
/// 14 dias (Diagnóstico Financeiro). Quando trialEndsAt passa sem
/// conversão, status vira EXPIRED e o app bloqueia acesso (paywall).
///
/// Pagamentos são gerenciados via Asaas. asaasCustomerId/SubscriptionId
/// são populados quando o user converte. PIX Automático e cartão
/// recorrente são as duas formas de pagamento mensal; anual aceita
/// PIX à vista ou cartão 12x sem juros.
model Subscription {
  id     String @id @default(uuid())
  userId String @unique

  status SubscriptionStatus @default(TRIAL)
  plan   SubscriptionPlan   @default(TRIAL)

  /// Janela do trial (Diagnóstico Financeiro de 14 dias).
  trialStartedAt DateTime  @default(now())
  trialEndsAt    DateTime
  /// Quando o trial expirou (sem conversão). null se ainda tá no trial
  /// ou se converteu antes de expirar.
  trialExpiredAt DateTime?

  /// Janela da assinatura paga atual. Pra MONTHLY = ciclo de 1 mês;
  /// pra ANNUAL = ciclo de 12 meses. Renovações sucessivas atualizam
  /// estes campos sem criar registros novos.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  /// Tracking de uso (analytics + futuro). daysActiveCount é incrementado
  /// pelo cron diário quando o user teve atividade (transação criada, msg
  /// no bot, login no app) no dia anterior.
  daysActiveCount   Int @default(0)
  transactionsCount Int @default(0)

  /// Integração Asaas (criados quando o user converte).
  asaasCustomerId     String?
  asaasSubscriptionId String?
  asaasPaymentMethod  String? // 'PIX' | 'CREDIT_CARD' | 'CREDIT_CARD_INSTALLMENT'

  /// Cancelamento. cancelledAt = quando o user pediu pra cancelar.
  /// Acesso continua até currentPeriodEnd. cancellationReason é texto
  /// livre coletado no fluxo de cancelamento (analytics de churn).
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEnd])
}

/// Histórico de mensagens de re-engajamento enviadas. Cron diário roda
/// Ter-Qui 10:30 BRT pra users em warning (d6) / at-risk (d14) /
/// inactive (d30). Cooldown 21d/45d/never. Cap lifetime: 3 nudges.
model ReengagementNudge {
  id               String   @id @default(uuid())
  userId           String
  sentAt           DateTime @default(now())
  /// 'sent' | 'failed'
  status           String
  /// erro details quando status='failed', senão null
  statusDetail     String?
  /// snapshot do engagementStatus do user no momento ('warning' | 'at-risk' | 'inactive')
  engagementStatus String
  /// quantos dias o user estava sem atividade quando o nudge foi disparado
  daysSinceLast    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentAt])
}

model Account {
  id              String      @id @default(uuid())
  userId          String
  name            String
  type            AccountType
  balance         Decimal     @default(0) @db.Decimal(15, 2)
  color           String      @default("#6366f1")
  icon            String      @default("wallet")
  isActive        Boolean     @default(true)
  isDefault       Boolean     @default(false)
  creditLimit     Decimal?    @db.Decimal(15, 2)
  closingDay      Int?
  dueDay          Int?
  linkedAccountId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  linkedAccount         Account?               @relation("CreditCardLink", fields: [linkedAccountId], references: [id], onDelete: SetNull)
  linkedCards           Account[]              @relation("CreditCardLink")
  invoices              Invoice[]              @relation("CardInvoices")

  @@index([userId])
  @@index([userId, isDefault])
}

model Invoice {
  id                String        @id @default(uuid())
  userId            String
  cardId            String
  periodStart       DateTime
  periodEnd         DateTime
  dueDate           DateTime
  total             Decimal       @default(0) @db.Decimal(15, 2)
  status            InvoiceStatus @default(OPEN)
  paidAt            DateTime?
  paidTransactionId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  card         Account       @relation("CardInvoices", fields: [cardId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("InvoiceTransactions")

  @@unique([cardId, periodEnd])
  @@index([userId])
  @@index([cardId, status])
  @@index([status, dueDate])
}

model Category {
  id       String          @id @default(uuid())
  userId   String?
  name     String
  icon     String          @default("tag")
  color    String          @default("#6366f1")
  type     TransactionType
  isSystem Boolean         @default(false)
  parentId String?

  parent                 Category?              @relation("CategoryTree", fields: [parentId], references: [id])
  subcategories          Category[]             @relation("CategoryTree")
  keywords               CategoryKeyword[]
  transactions           Transaction[]
  budgets                Budget[]
  recurringTransactions  RecurringTransaction[]
  user                   User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([parentId])
}

model CategoryKeyword {
  id         String @id @default(uuid())
  categoryId String
  keyword    String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, keyword])
  @@index([keyword])
}

model Transaction {
  id                     String          @id @default(uuid())
  userId                 String
  type                   TransactionType
  amount                 Decimal         @db.Decimal(15, 2)
  description            String
  date                   DateTime
  accountId              String
  categoryId             String?
  toAccountId            String?
  paymentMethod          PaymentMethod   @default(DEBIT)
  invoiceId              String?
  location               String?
  notes                  String?
  tags                   String[]
  isConfirmed            Boolean         @default(true)
  recurringTransactionId String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  recurringOccurrence  RecurringOccurrence?
  invoice              Invoice?              @relation("InvoiceTransactions", fields: [invoiceId], references: [id], onDelete: SetNull)
  installment          Installment?
  botMessage           BotMessage?

  @@index([userId, date])
  @@index([userId, type])
  @@index([accountId])
  @@index([categoryId])
  @@index([recurringTransactionId])
  @@index([invoiceId])
}

model Installment {
  id                String @id @default(uuid())
  transactionId     String @unique
  installmentNumber Int
  totalInstallments Int
  groupId           String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model RecurringTransaction {
  id            String              @id @default(uuid())
  userId        String
  description   String
  amount        Decimal             @db.Decimal(15, 2)
  type          TransactionType
  categoryId    String?
  accountId     String?
  frequency     RecurrenceFrequency
  startDate     DateTime
  endDate       DateTime?
  nextDueDate   DateTime
  snoozedUntil  DateTime?
  status        RecurrenceStatus    @default(ACTIVE)
  autoConfirm   Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  occurrences  RecurringOccurrence[]

  @@index([userId])
  @@index([status, nextDueDate])
}

// Cada parcela esperada de uma RecurringTransaction vira uma occurrence.
// Múltiplas podem ficar pendentes simultaneamente (ex: usuário não
// confirmou nem snoozed o lembrete e a próxima parcela teórica chegou).
// O cron payment-alerts gera occurrences à medida que dueDate é alcançado
// e olha occurrences PENDING (não nextDueDate da recorrência mãe).
model RecurringOccurrence {
  id                     String           @id @default(uuid())
  recurringTransactionId String
  dueDate                DateTime
  status                 OccurrenceStatus @default(PENDING)
  snoozedUntil           DateTime?
  paidTransactionId      String?          @unique
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  recurring   RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)
  transaction Transaction?         @relation(fields: [paidTransactionId], references: [id], onDelete: SetNull)

  // Idempotência: uma única occurrence por (recorrência, data) — evita duplicação
  // quando cron rodar duas vezes ou backfill colidir com geração futura.
  @@unique([recurringTransactionId, dueDate])
  @@index([status, dueDate])
  @@index([recurringTransactionId, status])
}

model Budget {
  id         String       @id @default(uuid())
  userId     String
  categoryId String
  amount     Decimal      @db.Decimal(15, 2)
  period     BudgetPeriod @default(MONTHLY)
  alertAt    Int          @default(80)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
  @@index([userId])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(15, 2)
  currentAmount Decimal   @default(0) @db.Decimal(15, 2)
  deadline      DateTime?
  icon          String    @default("target")
  color         String    @default("#10b981")
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BotConnection {
  id               String      @id @default(uuid())
  userId           String
  platform         BotPlatform
  platformUserId   String
  isVerified       Boolean     @default(false)
  verificationCode String?
  defaultAccountId String?
  /// Estágio do fluxo de welcome. "awaiting_first_message" = MSG1 enviada,
  /// esperando primeira resposta (saudação → MSG2; transação → fluxo normal).
  /// "done" (default) = welcome concluído OU usuário antigo. Migrations
  /// devem default users existentes pra "done" pra não re-disparar MSG2.
  welcomeStage     String      @default("done")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages BotMessage[]

  @@unique([platform, platformUserId])
  @@index([userId])
}

model BotMessage {
  id                String           @id @default(uuid())
  userId            String
  connectionId      String
  direction         MessageDirection
  rawContent        String
  mediaType         String?
  parsedData        Json?
  status            MessageStatus    @default(RECEIVED)
  transactionId     String?          @unique
  errorMessage      String?
  // wamid (WhatsApp Cloud API message id) ou equivalente Telegram.
  // Pra OUTBOUND interativos: permite o webhook resolver `context.id` do
  // button_reply de volta pra recurringId quando o template HSM devolve
  // o texto literal do botão em vez do payload dinâmico (templates QUICK_REPLY
  // sem example.payload no Meta Manager — fallback até reaprovação).
  externalMessageId String?
  createdAt         DateTime         @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection  BotConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([connectionId])
  @@index([status])
  @@index([externalMessageId])
}

model Insight {
  id          String   @id @default(uuid())
  userId      String
  title       String
  body        String
  type        String
  severity    String   @default("info")
  isRead      Boolean  @default(false)
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model CronRun {
  id          String   @id @default(uuid())
  jobName     String
  startedAt   DateTime
  finishedAt  DateTime
  durationMs  Int
  status      String   // "success" | "error"
  checked     Int      @default(0)
  sent        Int      @default(0)
  skipped     Int      @default(0)
  failed      Int      @default(0)
  result      Json?
  errorMsg    String?
  createdAt   DateTime @default(now())

  @@index([jobName, startedAt])
}

model NotificationSetting {
  id                     String  @id @default(uuid())
  userId                 String  @unique
  emailNotifications     Boolean @default(true)
  pushNotifications      Boolean @default(true)
  budgetAlerts           Boolean @default(true)
  goalAlerts             Boolean @default(true)
  weeklyReport           Boolean @default(true)
  monthlyReport          Boolean @default(true)
  botConfirmations       Boolean @default(true)
  autoInsights           Boolean @default(true)
  telegramInsights       Boolean @default(true)
  telegramAlerts         Boolean @default(true)
  eveningPaymentReminder Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
