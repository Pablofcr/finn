generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  DIGITAL_WALLET
  INVESTMENT
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum BotPlatform {
  WHATSAPP
  TELEGRAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  PROCESSING
  PARSED
  CONFIRMED
  REJECTED
  ERROR
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum Currency {
  BRL
  USD
  EUR
  GBP
}

enum UserPlan {
  FREE
  PRO
  MASTER
}

// ============================================================
// MODELS
// ============================================================

model User {
  id              String   @id @default(uuid())
  supabaseId      String   @unique
  email           String   @unique
  name            String
  phone           String?
  avatarUrl       String?
  plan            UserPlan @default(FREE)
  defaultCurrency Currency @default(BRL)
  timezone        String   @default("America/Sao_Paulo")
  locale          String   @default("pt-BR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  goals                 Goal[]
  botConnections        BotConnection[]
  botMessages           BotMessage[]
  insights              Insight[]
  recurringTransactions RecurringTransaction[]
  notificationSetting   NotificationSetting?

  @@index([supabaseId])
  @@index([email])
}

model Account {
  id          String      @id @default(uuid())
  userId      String
  name        String
  type        AccountType
  balance     Decimal     @default(0) @db.Decimal(15, 2)
  color       String      @default("#6366f1")
  icon        String      @default("wallet")
  isActive    Boolean     @default(true)
  creditLimit Decimal?    @db.Decimal(15, 2)
  closingDay  Int?
  dueDay      Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
}

model Category {
  id       String          @id @default(uuid())
  userId   String?
  name     String
  icon     String          @default("tag")
  color    String          @default("#6366f1")
  type     TransactionType
  isSystem Boolean         @default(false)
  parentId String?

  parent                 Category?              @relation("CategoryTree", fields: [parentId], references: [id])
  subcategories          Category[]             @relation("CategoryTree")
  keywords               CategoryKeyword[]
  transactions           Transaction[]
  budgets                Budget[]
  recurringTransactions  RecurringTransaction[]
  user                   User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([parentId])
}

model CategoryKeyword {
  id         String @id @default(uuid())
  categoryId String
  keyword    String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, keyword])
  @@index([keyword])
}

model Transaction {
  id                     String          @id @default(uuid())
  userId                 String
  type                   TransactionType
  amount                 Decimal         @db.Decimal(15, 2)
  description            String
  date                   DateTime
  accountId              String
  categoryId             String?
  toAccountId            String?
  location               String?
  notes                  String?
  tags                   String[]
  isConfirmed            Boolean         @default(true)
  recurringTransactionId String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  installment          Installment?
  botMessage           BotMessage?

  @@index([userId, date])
  @@index([userId, type])
  @@index([accountId])
  @@index([categoryId])
  @@index([recurringTransactionId])
}

model Installment {
  id                String @id @default(uuid())
  transactionId     String @unique
  installmentNumber Int
  totalInstallments Int
  groupId           String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model RecurringTransaction {
  id          String              @id @default(uuid())
  userId      String
  description String
  amount      Decimal             @db.Decimal(15, 2)
  type        TransactionType
  categoryId  String?
  accountId   String?
  frequency   RecurrenceFrequency
  startDate   DateTime
  endDate     DateTime?
  nextDueDate DateTime
  status      RecurrenceStatus    @default(ACTIVE)
  autoConfirm Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@index([status, nextDueDate])
}

model Budget {
  id         String       @id @default(uuid())
  userId     String
  categoryId String
  amount     Decimal      @db.Decimal(15, 2)
  period     BudgetPeriod @default(MONTHLY)
  alertAt    Int          @default(80)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
  @@index([userId])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(15, 2)
  currentAmount Decimal   @default(0) @db.Decimal(15, 2)
  deadline      DateTime?
  icon          String    @default("target")
  color         String    @default("#10b981")
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BotConnection {
  id               String      @id @default(uuid())
  userId           String
  platform         BotPlatform
  platformUserId   String
  isVerified       Boolean     @default(false)
  verificationCode String?
  defaultAccountId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages BotMessage[]

  @@unique([platform, platformUserId])
  @@index([userId])
}

model BotMessage {
  id            String           @id @default(uuid())
  userId        String
  connectionId  String
  direction     MessageDirection
  rawContent    String
  mediaType     String?
  parsedData    Json?
  status        MessageStatus    @default(RECEIVED)
  transactionId String?          @unique
  errorMessage  String?
  createdAt     DateTime         @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection  BotConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([connectionId])
  @@index([status])
}

model Insight {
  id          String   @id @default(uuid())
  userId      String
  title       String
  body        String
  type        String
  severity    String   @default("info")
  isRead      Boolean  @default(false)
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model NotificationSetting {
  id                 String  @id @default(uuid())
  userId             String  @unique
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)
  budgetAlerts       Boolean @default(true)
  goalAlerts         Boolean @default(true)
  weeklyReport       Boolean @default(true)
  monthlyReport      Boolean @default(true)
  botConfirmations   Boolean @default(true)
  autoInsights       Boolean @default(true)
  telegramInsights   Boolean @default(true)
  telegramAlerts     Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
